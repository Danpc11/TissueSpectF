# Outputs and downloads. config/project.R defaults every one of these to a
# directory inside the repository, so a fresh clone runs without configuration
# and nothing derived is ever committed.
data/
data*/
interim/
interim*/
results/
results*/
resultados*/

# R
.Rhistory
.RData
.Rproj.user/
*.Rproj.user

# Run logs from `./tsf --log <file>`: consensus_999.log and friends belong to
# one run on one machine, not in the history.
*.log

# R's default graphics device writes this whenever a plot is made with no
# device open. It is never wanted and it is never the same twice.
Rplots.pdf

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Bundles built by `./tsf bundle`; the release workflow publishes these as
# assets rather than committing them, because a binary reference does not
# belong in git.
TissueSpectF-app/
TissueSpectF-app.zip
TissueSpectF-app.zip.sha256
